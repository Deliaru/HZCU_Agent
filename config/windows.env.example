# Windows native local-development defaults.
# Copy this file to config/windows.env to keep machine-specific overrides.
# The launcher also works without the copy and uses this file directly.

HZCU_ENVIRONMENT=development
HZCU_DATABASE_URL=sqlite+aiosqlite:///./data/hzcu_agent.db
HZCU_SNAPSHOT_DIRECTORY=./data/snapshots
HZCU_LOG_LEVEL=INFO
HZCU_LOG_FORMAT=console

# Safe by default. Use -ModelMode Real with API.txt when a model is configured.
HZCU_MODEL_PROVIDER=demo
HZCU_AGENT_MODEL=gpt-5.6-sol
HZCU_UTILITY_MODEL=gpt-5.6-terra
HZCU_REASONING_EFFORT=medium

HZCU_AUTH_MODE=anonymous
HZCU_LOCAL_ADMIN_ENABLED=false
HZCU_AUTH_COOKIE_SECURE=false
HZCU_PUBLIC_API_BASE_URL=http://127.0.0.1:18000
HZCU_WEB_APP_URL=http://127.0.0.1:13000
HZCU_CORS_ORIGINS=http://127.0.0.1:13000,http://localhost:13000
# Windows 启动脚本会自动追加活动网卡的局域网 IPv4；手动启动 Web 时可在此补充主机名/IP。
HZCU_ALLOWED_DEV_ORIGINS=127.0.0.1,localhost
HZCU_PILOT_ANONYMOUS_CAMPUS_MIRROR=true
HZCU_CAMPUS_QUERY_ROUTE=disabled
HZCU_INGESTION_ALLOWED_VISIBILITIES=public

# The Next.js development server uses a same-origin /api/v1 rewrite.
NEXT_PUBLIC_API_BASE_URL=/api/v1
