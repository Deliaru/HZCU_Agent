# Production secrets are mounted as files by compose.production.yml.
# Keep the actual files under /etc/hzcu-agent with mode 0600.
#
# /etc/hzcu-agent/model_config.secret must contain the exact value currently
# used to encrypt runtime_model_configurations in the migrated SQLite database.
# /etc/hzcu-agent/auth_session.secret should be a new random value of at least
# 32 characters; changing it invalidates all browser sessions.

# The model endpoint and API key remain editable from /admin after login.
# No model API key is required in this file.
