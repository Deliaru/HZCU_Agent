# Runtime
HZCU_ENVIRONMENT=development
HZCU_DATABASE_URL=sqlite+aiosqlite:///./data/hzcu_agent.db
HZCU_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
HZCU_LOG_LEVEL=INFO
HZCU_LOG_FORMAT=console

# Model Gateway
# Keep "demo" until an API key is configured. Demo mode is visibly limited.
HZCU_MODEL_PROVIDER=demo
HZCU_OPENAI_API_KEY=
HZCU_OPENAI_BASE_URL=
HZCU_AGENT_MODEL=gpt-5.6-sol
HZCU_UTILITY_MODEL=gpt-5.6-terra
HZCU_REASONING_EFFORT=medium

# Agent budgets
HZCU_MAX_TOOL_ROUNDS=2
HZCU_MAX_TOOL_CALLS=8
HZCU_MODEL_TIMEOUT_SECONDS=60

# Source Registry and ingestion
# HZCU_SOURCE_REGISTRY_PATH=./apps/api/src/hzcu_agent/resources/sources.yaml
HZCU_SNAPSHOT_DIRECTORY=./data/snapshots
HZCU_SYNC_MAX_CONCURRENCY=4
HZCU_MAX_DOWNLOAD_BYTES=26214400
# Add campus only on an approved network/worker identity:
HZCU_INGESTION_ALLOWED_VISIBILITIES=public

# Campus identity and read-only notice access (Stage 2)
# Information Services must register the exact callback URL. Prefer an HTTPS CA
# entry; only set the explicit HTTP approval flag after written network approval.
HZCU_AUTH_MODE=anonymous
HZCU_PUBLIC_API_BASE_URL=http://localhost:8000
HZCU_WEB_APP_URL=http://localhost:3000
HZCU_CAS_BROWSER_BASE_URL=http://ca.hzcu.edu.cn/cas
HZCU_CAS_SERVER_BASE_URL=http://ca.hzcu.edu.cn/cas
HZCU_CAS_VALIDATION_PATH=/serviceValidate
HZCU_CAS_SERVICE_REGISTERED=false
HZCU_CAS_HTTP_TRANSPORT_APPROVED=false
# Generate an independent random value of at least 32 characters before enabling CAS.
HZCU_AUTH_SESSION_SECRET=
HZCU_AUTH_SESSION_HOURS=8
HZCU_AUTH_STATE_MINUTES=10
HZCU_VISITOR_SESSION_DAYS=180
# Stage 6 Pilot: anonymous devices may read already-approved Campus rows from
# the local mirror. This does not enable live Campus queries or change ingestion.
HZCU_PILOT_ANONYMOUS_CAMPUS_MIRROR=true
# Comma-separated CA subjects. Keep this value only in deployment secrets.
HZCU_ADMIN_CAS_SUBJECTS=
# Independent backend administrator login. In development, initialize it on
# /login. If HZCU_ADMIN_CAS_SUBJECTS is set, the username must match that list.
HZCU_LOCAL_ADMIN_ENABLED=false
# Development fallback only; the generated value is never printed.
HZCU_LOCAL_AUTH_SECRET_PATH=./data/local_auth.secret

# Campus query routing. "auto" probes direct campus reachability first, then uses
# an already established VPN sidecar lease. Credentials are never persisted.
HZCU_CAMPUS_QUERY_ROUTE=disabled
HZCU_CAMPUS_DIRECT_PROBE_URL=http://hzcujwb.hzcu.edu.cn/index.php?c=main&a=tlist&id=3
HZCU_CAMPUS_DIRECT_PROBE_SECONDS=30
HZCU_CREDENTIAL_VPN_ENABLED=false
HZCU_VPN_SIDECAR_BASE_URL=
HZCU_VPN_SIDECAR_API_TOKEN=
HZCU_VPN_SIDECAR_TIMEOUT_SECONDS=60
HZCU_VPN_SESSION_MINUTES=15

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Stage 6 single-node pilot
HZCU_PILOT_ORIGIN=http://localhost:8080
HZCU_PILOT_PORT=8080
HZCU_PILOT_DATA_DIR=./data
HZCU_MAX_CONCURRENT_AGENT_TASKS=4
HZCU_MAX_ACTIVE_TASKS_PER_SUBJECT=1
